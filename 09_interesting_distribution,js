const r = require("raylib");

function createCountArr(length) {
  const counts = [0, 0, 0, 0, 0];

  for (let i = 0; i < length; i++) {
    const val = (Math.random() * 0.5) + (Math.random() * 0.5);
    counts[Math.floor(val * 5)]++;
  }

  return counts;
}

function setup() {
  const screen = {
    width: 600,
    height: 600,
    title: "Probability Distribution",
    fps: 50,
  }

  const length = 1000;
  const counts = createCountArr(length, screen.width, screen.height);

  r.SetTraceLogLevel(r.LOG_NONE);
  r.InitWindow(screen.width, screen.height, screen.title);
  r.SetTargetFPS(screen.fps);

  return {
    counts,
    screen
  };
}

function draw(w) {
  r.BeginDrawing();

  r.ClearBackground(r.WHITE);

  for (let idx = 0; idx < w.counts.length; idx++) {
    const x = idx * (w.screen.width / 5) + 45;
    const y = w.screen.height - w.counts[idx];

    r.DrawRectangle(x, y, 40, w.screen.height, r.BLACK);
  }

  r.EndDrawing();
}

function loop(world) {
  while (!r.WindowShouldClose()) {
    draw(world);
  }
}

function teardown() {
  r.CloseWindow();
}

function main() {
  const world = setup();
  loop(world);
  teardown();
}

main();